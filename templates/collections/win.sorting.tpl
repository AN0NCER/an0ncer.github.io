<span class="windowed window-collection-sorting unselectable hide">
    <span class="hide-window"></span>
    <span class="window-content content-collection-sorting scroll-none hide">
        <span class="content-wrapper">
            <div class="wrapper">
                <div class="window-bar collection-sorting-bar">
                    <div class="window-title">Сортировка</div>
                    <div class="window-bar-wrapper">
                        <div class="win-bar-btn window-close">
                            <svg class="icon" viewBox="0 0 640 640" aria-hidden="true">
                                <use href="#i-xmark"></use>
                            </svg>
                        </div>
                    </div>
                </div>
                <div class="sorting-group">
                    <div class="group-wrapper">
                        <div class="sorting-title">По названию</div>
                        <div class="group-sorting-wrapper" data-sort="title">
                            <div class="bg-selector">
                                <div class="selector"></div>
                            </div>
                            <div class="sorting-items">
                                <div class="item" data-value="asc">А–Я</div>
                                <div class="item" data-value="desc">Я–А</div>
                            </div>
                        </div>
                    </div>

                    <div class="group-wrapper">
                        <div class="sorting-title">По количеству</div>
                        <div class="group-sorting-wrapper" data-sort="count">
                            <div class="bg-selector">
                                <div class="selector"></div>
                            </div>
                            <div class="sorting-items">
                                <div class="item" data-value="desc">От большего</div>
                                <div class="item" data-value="asc">От меньшего</div>
                            </div>
                        </div>
                    </div>

                    <div class="group-wrapper">
                        <div class="sorting-title">По обновлению</div>
                        <div class="group-sorting-wrapper" data-sort="updated">
                            <div class="bg-selector">
                                <div class="selector"></div>
                            </div>
                            <div class="sorting-items">
                                <div class="item" data-value="desc">Сначала новые</div>
                                <div class="item" data-value="asc">Сначала старые</div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="sorting-line"></div>
                <div class="sorting-group">
                    <div class="group-wrapper">
                        <div class="sorting-title">Автогруппы</div>
                        <div class="group-sorting-wrapper --filter" data-sort="groups">
                            <div class="bg-selector">
                                <div class="selector"></div>
                            </div>
                            <div class="sorting-items">
                                <div class="item" data-value="on">Включены</div>
                                <div class="item" data-value="off">Выключены</div>
                            </div>
                        </div>
                        <div class="sorting-description">Сортировка будет работать для автогрупп целиком</div>
                    </div>
                </div>
                <div class="win-actions-wrapper">
                    <div class="win-actions">
                        <div class="default-wrapper">
                            <div class="btn-action" data-type="reset">
                                Сбросить сортировку
                            </div>
                        </div>
                    </div>
                </div>
                <div class="safe-area-actions"></div>
            </div>
        </span>
    </span>
    <svg xmlns="http://www.w3.org/2000/svg" style="display: none;">
        <!--!Font Awesome Free v7.1.0 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free Copyright 2026 Fonticons, Inc.-->
        <symbol id="i-xmark" viewBox="0 0 640 640">
            <path
                d="M183.1 137.4C170.6 124.9 150.3 124.9 137.8 137.4C125.3 149.9 125.3 170.2 137.8 182.7L275.2 320L137.9 457.4C125.4 469.9 125.4 490.2 137.9 502.7C150.4 515.2 170.7 515.2 183.2 502.7L320.5 365.3L457.9 502.6C470.4 515.1 490.7 515.1 503.2 502.6C515.7 490.1 515.7 469.8 503.2 457.3L365.8 320L503.1 182.6C515.6 170.1 515.6 149.8 503.1 137.3C490.6 124.8 470.3 124.8 457.8 137.3L320.5 274.7L183.1 137.4z" />
        </symbol>
    </svg>
</span>